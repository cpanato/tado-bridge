{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "credentials",
    "secrets",
    "config",
    "trmnl",
    "service",
    "history"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Never",
            "Always"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingClaim"
      ],
      "properties": {
        "existingClaim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "apiTokenKey",
        "trmnlWebhookKey"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "apiTokenKey": {
          "type": "string",
          "minLength": 1
        },
        "trmnlWebhookKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "port"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pollInterval",
        "maxSnapshotAge",
        "dailyRequestBudget",
        "metricsEnabled",
        "metricsRoomDetails"
      ],
      "properties": {
        "pollInterval": {
          "type": "string",
          "minLength": 1
        },
        "maxSnapshotAge": {
          "type": "string",
          "minLength": 1
        },
        "dailyRequestBudget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "metricsEnabled": {
          "type": "boolean"
        },
        "metricsRoomDetails": {
          "type": "boolean"
        }
      }
    },
    "trmnl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "interval",
        "rooms"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string",
          "minLength": 1
        },
        "rooms": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "home_id",
              "zone_id"
            ],
            "properties": {
              "home_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "zone_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "name": {
                "type": "string",
                "maxLength": 48
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingCASecret",
        "caKey"
      ],
      "properties": {
        "existingCASecret": {
          "type": "string"
        },
        "caKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hostAliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ip",
          "hostnames"
        ],
        "properties": {
          "ip": {
            "type": "string",
            "minLength": 1
          },
          "hostnames": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingSecret",
        "databaseURLKey",
        "retention"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "databaseURLKey": {
          "type": "string",
          "minLength": 1
        },
        "retention": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
